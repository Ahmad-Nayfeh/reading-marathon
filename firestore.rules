rules_version = '2';

// Every reader signs in (Google or guest). A reader's own log (users/{uid}/days) is private.
// Groups: access comes from the group's `roles` map {uid: "owner" | "admin" | "member"}.
// Members write only their own reading; owners and admins manage the group. The platform admin
// (one verified Google account) can read and manage everything.
// Paste into Firebase console → Firestore → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // A suspended account (banned/{uid}) can do nothing at all.
    function signedIn() { return request.auth != null && !exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'readingmarathon.admin@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function groupPath(gid) { return /databases/$(database)/documents/groups/$(gid); }
    function roleIn(gid) { return get(groupPath(gid)).data.roles.get(uid(), null); }
    function isMember(gid) { return isAdmin() || (signedIn() && roleIn(gid) != null); }
    function isManager(gid) { return isAdmin() || (signedIn() && roleIn(gid) in ['owner', 'admin']); }
    function isOwner(gid) { return isAdmin() || (signedIn() && roleIn(gid) == 'owner'); }
    function validDate(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function validMinutes(m) { return m is int && m >= 0 && m <= 960; }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 40; }

    // The reader's profile: chosen name, daily goal, and which groups they are in.
    match /users/{userId} {
      allow get: if signedIn() && (uid() == userId || isAdmin());
      allow list: if isAdmin();
      allow update: if isAdmin();
      allow create, update: if signedIn() && uid() == userId
                            && request.resource.data.keys().hasOnly(['email', 'name', 'guest', 'goal', 'groups', 'createdAt', 'lastSeen'])
                            && request.resource.data.get('email', null) == request.auth.token.get('email', null)
                            && (!('name' in request.resource.data) || validName(request.resource.data.name))
                            && (!('groups' in request.resource.data) || (request.resource.data.groups is list && request.resource.data.groups.size() <= 20));
      allow delete: if isAdmin();

      // Minutes per book per day (the day documents below hold the totals).
      match /reads/{rid} {
        allow read: if signedIn() && uid() == userId;
        allow delete: if (signedIn() && uid() == userId) || isAdmin();
        allow create, update: if signedIn() && uid() == userId
                              && request.resource.data.keys().hasOnly(['date', 'bookId', 'minutes', 'updatedAt'])
                              && validDate(request.resource.data.date)
                              && request.resource.data.bookId is string && request.resource.data.bookId.size() > 0
                              && rid == request.resource.data.date + '_' + request.resource.data.bookId
                              && validMinutes(request.resource.data.minutes);
      }

      // The reader's shelf: their books and running totals.
      match /shelf/{bid} {
        allow read: if signedIn() && uid() == userId;
        allow delete: if (signedIn() && uid() == userId) || isAdmin();
        allow create, update: if signedIn() && uid() == userId
                              && request.resource.data.keys().hasOnly(['title', 'author', 'status', 'minutes', 'startedAt', 'finishedAt', 'lastReadAt'])
                              && request.resource.data.status in ['reading', 'finished', 'want']
                              && request.resource.data.title is string && request.resource.data.title.size() <= 120;
      }

      // The reader's own log, one document per day.
      match /days/{date} {
        allow read: if signedIn() && uid() == userId;
        allow delete: if isAdmin();
        allow write: if signedIn() && uid() == userId
                     && request.resource.data.keys().hasOnly(['date', 'minutes', 'updatedAt'])
                     && request.resource.data.date == date && validDate(date)
                     && validMinutes(request.resource.data.minutes);
      }
    }

    // The platform admin panel reads across everything with collection-group queries.
    match /{path=**}/days/{doc} { allow read: if isAdmin(); }
    match /{path=**}/reads/{doc} { allow read: if isAdmin(); }
    match /{path=**}/shelf/{doc} { allow read: if isAdmin(); }
    match /{path=**}/members/{doc} { allow read: if isAdmin(); }
    match /{path=**}/challenges/{doc} { allow read: if isAdmin(); }
    match /{path=**}/entries/{doc} { allow read: if isAdmin(); }
    match /{path=**}/finishes/{doc} { allow read: if isAdmin(); }

    // The shared book catalog: everyone reads it; a reader may add a book only as "pending" (the
    // admin reviews it); everything else is the platform admin's.
    match /books/{bid} {
      allow read: if signedIn();
      allow create: if isAdmin()
                    || (signedIn()
                        && request.resource.data.keys().hasOnly(['title', 'author', 'aliases', 'keys', 'pages', 'status', 'mergedInto', 'createdBy', 'createdAt'])
                        && request.resource.data.status == 'pending'
                        && request.resource.data.createdBy == uid()
                        && request.resource.data.mergedInto == null
                        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
                        && request.resource.data.author is string && request.resource.data.author.size() > 0 && request.resource.data.author.size() <= 120
                        && request.resource.data.keys is list && request.resource.data.keys.size() <= 400
                        && request.resource.data.aliases is list && request.resource.data.aliases.size() == 0);
      allow update, delete: if isAdmin();
    }

    // Suggestions: a reader files their own, and reads only their own; the admin resolves them.
    match /suggestions/{sid} {
      allow get: if isAdmin() || (signedIn() && resource.data.by == uid());
      allow list: if isAdmin() || (signedIn() && resource.data.by == uid());
      allow create: if signedIn()
                    && request.resource.data.by == uid()
                    && request.resource.data.status == 'open'
                    && request.resource.data.type in ['new_book', 'fix', 'duplicate']
                    && request.resource.data.reply == ''
                    && request.resource.data.note is string && request.resource.data.note.size() <= 500;
      allow update, delete: if isAdmin();
    }

    match /announcements/{aid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Suspended accounts. The account itself may see that it is suspended.
    match /banned/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list, write: if isAdmin();
    }

    match /adminLog/{id} {
      allow read, write: if isAdmin();
    }

    // Invite codes map to a group. Readable one at a time (never listed), so codes can't be enumerated.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == uid()
                    && request.resource.data.keys().hasOnly(['groupId', 'createdBy'])
                    && (isAdmin() || getAfter(groupPath(request.resource.data.groupId)).data.roles.get(uid(), null) in ['owner', 'admin']);
      allow update: if false;
      allow delete: if isManager(resource.data.groupId);
    }

    match /groups/{gid} {
      // Group ids are random and only shared with members; public groups can also be listed.
      allow get: if signedIn();
      allow list: if isAdmin() || (signedIn() && resource.data.visibility == 'public');
      allow create: if signedIn()
                    && request.resource.data.roles.keys().hasOnly([uid()])
                    && request.resource.data.roles[uid()] == 'owner'
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
                    && request.resource.data.visibility in ['public', 'private'];
      allow update: if
        // The owner manages everything, roles included, but stays in the group (handing over leaves them an admin).
        isAdmin()
        || (isOwner(gid) && uid() in request.resource.data.roles)
        // Admins manage the group; on roles they may only remove a plain member.
        || (isManager(gid)
            && request.resource.data.roles.diff(resource.data.roles).addedKeys().size() == 0
            && request.resource.data.roles.diff(resource.data.roles).changedKeys().size() == 0
            // Only plain members may go: the owner and admins left over stay the same.
            && request.resource.data.roles.values().removeAll(['member']).size() == resource.data.roles.values().removeAll(['member']).size())
        // Joining: add only yourself, as a member, in the same batch as your member document
        // (whose rule checks the invite code for a private group).
        || (signedIn()
            && !(uid() in resource.data.roles)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles'])
            && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([uid()])
            && request.resource.data.roles[uid()] == 'member'
            && existsAfter(/databases/$(database)/documents/groups/$(gid)/members/$(uid()))
            && getAfter(/databases/$(database)/documents/groups/$(gid)/members/$(uid())).data.linkedUid == uid())
        // Leaving: remove only yourself (the owner hands over ownership first).
        || (signedIn()
            && resource.data.roles.get(uid(), null) in ['admin', 'member']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles'])
            && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([uid()])
            && !(uid() in request.resource.data.roles));
      allow delete: if isOwner(gid);

      match /members/{mid} {
        allow read: if isMember(gid);
        allow create, update: if isManager(gid)
          || (signedIn() && mid == uid()
              && request.resource.data.keys().hasOnly(['name', 'linkedUid', 'active', 'joinedAt', 'code'])
              && request.resource.data.linkedUid == uid()
              && validName(request.resource.data.name)
              && request.resource.data.active is bool
              && (
                // Already in the group: rename yourself, or mark yourself gone when leaving.
                (roleIn(gid) != null && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['name', 'active']))
                // Joining: the group is public, or you hold its current invite code.
                || (getAfter(groupPath(gid)).data.roles.get(uid(), null) == 'member'
                    && request.resource.data.active == true
                    && (get(groupPath(gid)).data.visibility == 'public'
                        || request.resource.data.get('code', '') == get(groupPath(gid)).data.inviteCode))));
        allow delete: if isManager(gid);
      }

      match /challenges/{cid} {
        allow read: if isMember(gid);
        allow write: if isManager(gid)
                     && (request.resource == null
                         || (request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
                             && validDate(request.resource.data.start) && validDate(request.resource.data.end)));
      }

      match /entries/{eid} {
        allow read: if isMember(gid);
        allow create, update: if isMember(gid)
                              && request.resource.data.keys().hasOnly(['memberId', 'date', 'minutes', 'updatedAt', 'sharedMinutes'])
                              && request.resource.data.get('sharedMinutes', 0) is int
                              && request.resource.data.get('sharedMinutes', 0) >= 0
                              && request.resource.data.get('sharedMinutes', 0) <= request.resource.data.minutes
                              && eid == request.resource.data.memberId + '_' + request.resource.data.date
                              && validDate(request.resource.data.date)
                              && validMinutes(request.resource.data.minutes)
                              && (request.resource.data.memberId == uid() || isManager(gid));
        allow delete: if isManager(gid) || (isMember(gid) && resource.data.memberId == uid());
      }

      match /finishes/{fid} {
        allow read: if isMember(gid);
        allow create, update: if isMember(gid)
                              && request.resource.data.keys().hasOnly(['memberId', 'challengeId', 'date'])
                              && fid == request.resource.data.memberId + '_' + request.resource.data.challengeId
                              && validDate(request.resource.data.date)
                              && (request.resource.data.memberId == uid() || isManager(gid));
        allow delete: if isManager(gid) || (isMember(gid) && resource.data.memberId == uid());
      }
    }
  }
}
